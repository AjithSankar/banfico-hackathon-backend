# Hackathon Mock Bank sandbox (Keycloak OAuth2 password grant + OBIE AISP v4.0 API).
# These are backend/app-level credentials, NOT the end user's bank login (that's submitted
# by the frontend via POST /api/auth/login).
SANDBOX_DOMAIN=obiebank-sbx.banfico.io
SANDBOX_TENANT=provider
SANDBOX_CLIENT_ID=corebank-spa
SANDBOX_CLIENT_SECRET=corebank-spa-password

# CORS: comma-separated list of allowed frontend origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring AI — Ollama (local), no API key required
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434

# Test end-user credentials for POST /api/auth/login during local dev (NOT app config —
# copy this file to .env, which is gitignored, and fill in real values there).
SANDBOX_TEST_USERNAME=changeme@example.com
SANDBOX_TEST_PASSWORD=changeme
