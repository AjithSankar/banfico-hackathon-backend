            "description": "Demo-seeding only (bonus) \u2014 not a core end-user-facing feature. Creates a transaction directly in the sandbox in OBIE shape.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"TransactionReference\": \"{{$randomUUID}}\",\n    \"Amount\": {\n        \"Amount\": \"25.50\",\n        \"Currency\": \"GBP\"\n    },\n    \"CreditDebitIndicator\": \"Credit\",\n    \"Status\": \"Booked\",\n    \"BookingDateTime\": \"{{$isoTimestamp}}\",\n    \"ValueDateTime\": \"{{$isoTimestamp}}\",\n    \"TransactionInformation\": \"{{$randomLoremWords}}\",\n    \"BankTransactionCode\": {\n        \"Code\": \"IssuedCreditTransfer\",\n        \"SubCode\": \"AutomaticTransfer\"\n    },\n    \"ProprietaryBankTransactionCode\": {\n        \"Code\": \"Transfer\",\n        \"Issuer\": \"CoreBank\"\n    },\n    \"ExtendedProprietaryBankTransactionCodes\": [\n        {\n            \"Code\": \"{{$randomWord}}\"\n        }\n    ],\n    \"Balance\": {\n        \"Amount\": {\n            \"Amount\": \"1925.78\",\n            \"Currency\": \"GBP\"\n        },\n        \"CreditDebitIndicator\": \"Credit\",\n        \"Type\": \"ITBD\"\n    },\n    \"PaymentPurposeCode\": \"CASH\",\n    \"MerchantDetails\": {\n        \"MerchantName\": \"{{$randomCompanyName}}\",\n        \"MerchantCategoryCode\": \"1711\"\n    },\n    \"CreditorAgent\": {\n        \"SchemeName\": \"UK.OBIE.BICFI\",\n        \"Identification\": \"SC802001\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"CreditorAccount\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\"\n    },\n    \"DebtorAgent\": {\n        \"SchemeName\": \"UK.OBIE.BICFI\",\n        \"Identification\": \"SC802002\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"DebtorAccount\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\"\n    },\n    \"UltimateCreditor\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"UltimateDebtor\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"CardInstrument\": {\n        \"CardSchemeName\": \"MasterCard\",\n        \"AuthorisationType\": \"PIN\"\n    }\n}",
              "options": {
